{
  "info": {
    "name": "Real Estate Lead Scoring - Security Negative Tests",
    "_postman_id": "2b8c0d4e-7a55-4e9a-9f6b-security-qa-2026",
    "description": "SEC-T01 and SEC-T02 automated negative authentication/authorization checks. Credentials are supplied at runtime through Newman environment variables and are never stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://real-estate-lead-scoring.vercel.app"
    },
    {
      "key": "agentEmail",
      "value": ""
    },
    {
      "key": "agentPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "SEC-T01 - Invalid Bearer Token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer definitely-invalid-token"
          }
        ],
        "url": "{{baseUrl}}/api/inquiries"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid bearer token is rejected', function () {",
              "    pm.expect(pm.response.code).to.eql(401);",
              "});",
              "",
              "pm.test('Response is JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "SEC-T02 - Agent Blocked From Super Admin Platform",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Agent login succeeds', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.accessToken).to.exist;",
              "});",
              "pm.collectionVariables.set('agentToken', body.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{agentEmail}}\",\"password\":\"{{agentPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "SEC-T02 - Access Super Admin Agencies With Agent Token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{agentToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/platform/agencies"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Agent cannot access super-admin platform endpoint', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
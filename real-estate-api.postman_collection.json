    {
      "name": "Security - Inquiry List RBAC",
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://real-estate-lead-scoring.vercel.app/api/inquiries",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "",
              "    pm.test(\"Inquiry endpoint responds\", function () {",
              "        pm.expect(pm.response.code).to.be.oneOf([",
              "            200,",
              "            401,",
              "            403",
              "        ]);",
              "    });",
              "",
              "    console.log(",
              "        \"RBAC observed status:\",",
              "        pm.response.code",
              "    );",
              "",
              "})();"
            ]
          }
        }
      ]

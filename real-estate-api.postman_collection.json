  "item": [
    {
      "name": "New Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Login returns 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Access token is returned\", function () {\r",
              "    pm.expect(jsonData.accessToken).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"User role is super_admin\", function () {\r",
              "    pm.expect(jsonData.user.role).to.eql(\"super_admin\");\r",
              "});",
              "",
              "pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"test.superadmin@example.com\",\r\n  \"password\": \"Password123!\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://real-estate-lead-scoring.vercel.app/api/auth/login",
          "protocol": "https",
          "host": [
            "real-estate-lead-scoring",
            "vercel",
            "app"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Properties - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://real-estate-lead-scoring.vercel.app/api/properties?page=1&limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "",
              "    pm.test(\"Properties returns 200\", function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "",
              "    var body = pm.response.json();",
              "",
              "    pm.test(\"Properties items exist\", function () {",
              "        pm.expect(body.items).to.be.an(\"array\");",
              "    });",
              "",
              "    pm.test(\"Pagination exists\", function () {",
              "        pm.expect(body.pagination).to.be.an(\"object\");",
              "    });",
              "",
              "    if (body.items && body.items.length > 0) {",
              "        pm.collectionVariables.set(",
              "            \"propertyId\",",
              "            body.items[0]._id",
              "        );",
              "    }",
              "",
              "    pm.test(\"First property ID saved\", function () {",
              "        pm.expect(",
              "            pm.collectionVariables.get(\"propertyId\")",
              "        ).to.exist;",
              "    });",
              "",
              "})();"
            ]
          }
        }
      ]
    },
    {
